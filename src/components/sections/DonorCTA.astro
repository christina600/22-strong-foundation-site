---
---

<section class="dcta" aria-labelledby="dcta-heading">
  <div class="dcta__inner">

    <!-- Copy column -->
    <div class="dcta__copy">
      <h2 class="dcta__heading" id="dcta-heading">
        Help us take care of our own.
      </h2>
      <p class="dcta__lead lead">When you support 22STRONG, you are:</p>

      <ul class="dcta__outcomes" role="list">
        <li class="dcta__outcome">
          <strong class="dcta__outcome-title">Funding treatment</strong>
          <span class="dcta__outcome-desc">
            When a veteran's coverage runs out, is delayed, or is denied.
          </span>
        </li>
        <li class="dcta__outcome">
          <strong class="dcta__outcome-title">Protecting their progress</strong>
          <span class="dcta__outcome-desc">
            So the work they have already put in isn't lost.
          </span>
        </li>
        <li class="dcta__outcome">
          <strong class="dcta__outcome-title">Showing a veteran they have someone in their corner.</strong>
        </li>
      </ul>

      <a href="/donate" class="pill dcta__cta">Make a Gift</a>
    </div>

    <!-- Treatment image -->
    <figure class="dcta__figure" aria-hidden="true">
      <img
        src="/images/treatment-therapy-closeup.jpg"
        alt=""
        class="dcta__img"
        loading="lazy"
        decoding="async"
      />
    </figure>

  </div>
</section>
