---
/**
 * VeteranCareGap — Section 3
 * "When the system stops short, we step in."
 * Solution statement + vertical visual flow + donor CTA.
 */
---

<section class="vc-gap" aria-labelledby="vc-gap-heading">
  <div class="vc-gap__inner">

    <!-- Heading block -->
    <div class="vc-gap__header">
      <p class="eyebrow vc-gap__eyebrow">How we help</p>
      <h2 class="vc-gap__heading" id="vc-gap-heading">
        When the system stops short, we step in.
      </h2>
      <p class="vc-gap__lead lead">
        22STRONG helps veterans continue quality sports medicine and physical
        recovery care when access or coverage falls short.
      </p>
    </div>

    <!-- Visual flow -->
    <div class="vc-gap__flow" aria-label="How 22STRONG keeps recovery moving">
      <ol class="vc-gap__flow-list" role="list">

        <li class="vc-gap__flow-step">
          <span class="vc-gap__flow-icon" aria-hidden="true">
            <!-- Veteran silhouette -->
            <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
              <circle cx="16" cy="8" r="4.5" fill="currentColor"/>
              <path d="M9 28v-7a7 7 0 0 1 14 0v7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
            </svg>
          </span>
          <span class="vc-gap__flow-label">A veteran needs care</span>
        </li>

        <li class="vc-gap__flow-step vc-gap__flow-step--connector" aria-hidden="true">
          <span class="vc-gap__flow-arrow">↓</span>
        </li>

        <li class="vc-gap__flow-step">
          <span class="vc-gap__flow-icon vc-gap__flow-icon--alert" aria-hidden="true">
            <!-- Warning / gap -->
            <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
              <path d="M16 4 L29 28 H3 Z" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"/>
              <line x1="16" y1="13" x2="16" y2="20" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
              <circle cx="16" cy="24" r="1.2" fill="currentColor"/>
            </svg>
          </span>
          <span class="vc-gap__flow-label">Access or coverage falls short</span>
        </li>

        <li class="vc-gap__flow-step vc-gap__flow-step--connector" aria-hidden="true">
          <span class="vc-gap__flow-arrow">↓</span>
        </li>

        <li class="vc-gap__flow-step vc-gap__flow-step--highlight">
          <span class="vc-gap__flow-icon" aria-hidden="true">
            <!-- Heart / foundation -->
            <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
              <path d="M16 27S4 20 4 12a6 6 0 0 1 12-1 6 6 0 0 1 12 1c0 8-12 15-12 15Z" stroke="currentColor" stroke-width="2.2" stroke-linejoin="round"/>
            </svg>
          </span>
          <span class="vc-gap__flow-label">22STRONG helps fund treatment</span>
        </li>

        <li class="vc-gap__flow-step vc-gap__flow-step--connector" aria-hidden="true">
          <span class="vc-gap__flow-arrow">↓</span>
        </li>

        <li class="vc-gap__flow-step">
          <span class="vc-gap__flow-icon" aria-hidden="true">
            <!-- Checkmark / care continues -->
            <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
              <circle cx="16" cy="16" r="12" stroke="currentColor" stroke-width="2.2"/>
              <path d="M10 16.5l4 4 8-8" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
          <span class="vc-gap__flow-label">Care continues</span>
        </li>

        <li class="vc-gap__flow-step vc-gap__flow-step--connector" aria-hidden="true">
          <span class="vc-gap__flow-arrow">↓</span>
        </li>

        <li class="vc-gap__flow-step vc-gap__flow-step--outcome">
          <span class="vc-gap__flow-icon" aria-hidden="true">
            <!-- Upward arrow / recovery moving -->
            <svg viewBox="0 0 32 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
              <path d="M16 26V6" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
              <path d="M9 13l7-7 7 7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
          <span class="vc-gap__flow-label">Recovery keeps moving</span>
        </li>

      </ol>
    </div>

    <!-- Closing CTA -->
    <div class="vc-gap__cta">
      <p class="vc-gap__cta-text">Your support helps keep treatment going.</p>
      <a href="#donate" class="pill primary vc-gap__cta-btn">Support a Veteran</a>
    </div>

  </div>
</section>
