---
/**
 * VeteranAccessHero — Section 1
 * "Veterans helping veterans get the care they need."
 * Full-bleed split: headline + dual CTAs on the left, photo on the right.
 */
---

<section class="va-hero" aria-labelledby="va-hero-heading">
  <div class="va-hero__inner">

    <div class="va-hero__copy">
      <p class="eyebrow va-hero__eyebrow">Veteran recovery support</p>
      <h2 class="va-hero__heading" id="va-hero-heading">
        Veterans helping veterans get the care they need.
      </h2>
      <p class="va-hero__lead">
        When delays, limited authorizations, gaps in coverage, or long drives stand
        between a veteran and the physical care they need, 22STRONG helps keep
        recovery moving.
      </p>
      <div class="va-hero__actions">
        <a href="#contact" class="pill primary va-hero__btn">Get Help</a>
        <a href="#donate"  class="pill va-hero__btn va-hero__btn--ghost">Support a Veteran</a>
      </div>
    </div>

    <figure class="va-hero__figure" aria-hidden="true">
      <!-- Replace veteran-crutches-rehab.jpg with the crutches/rehab photo once saved to public/images/ -->
      <img
        src="/images/veteran-crutches-rehab.jpg"
        alt=""
        class="va-hero__photo"
        loading="lazy"
        decoding="async"
        width="720"
        height="540"
        onerror="this.src='/images/story-assisted-rehab.webp'"
      />
    </figure>

  </div>
</section>
