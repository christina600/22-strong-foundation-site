---
/**
 * VeteranLifeReturn — "Getting better means getting life back."
 * Layout: copy (left) + staggered 3-image grid (right)
 * Mood shift: from treatment and obstacles → life returning.
 */
---

<section class="vlr" aria-labelledby="vlr-heading">
  <div class="vlr__inner">

    <!-- Left: copy -->
    <div class="vlr__copy">
      <h2 class="vlr__heading" id="vlr-heading">
        Getting better means getting life back.
      </h2>
      <p class="vlr__lead lead">
        Recovery is about more than hurting less.
      </p>

      <ul class="vlr__list" role="list">
        <li class="vlr__item">Getting back to work.</li>
        <li class="vlr__item">Moving more freely.</li>
        <li class="vlr__item">Exercising again.</li>
        <li class="vlr__item">Working in the yard.</li>
        <li class="vlr__item">Spending time with family.</li>
        <li class="vlr__item vlr__item--closing">
          Returning to the parts of life an injury has slowly taken away.
        </li>
      </ul>
    </div>

    <!-- Right: staggered 3-image grid -->
    <div class="vlr__grid" aria-hidden="true">

      <!-- Large image — spans 2 rows -->
      <figure class="vlr__fig vlr__fig--large">
        <img
          src="/images/veterans-conversation-home-interior-wide.jpg"
          alt=""
          class="vlr__img"
          loading="lazy"
          decoding="async"
        />
      </figure>

      <!-- Small image 1 — exercise / movement -->
      <figure class="vlr__fig vlr__fig--small">
        <img
          src="/images/trail-runner-country-road-blue-sky-wide.jpg"
          alt=""
          class="vlr__img"
          loading="lazy"
          decoding="async"
        />
      </figure>

      <!-- Small image 2 — garden / family / hobby -->
      <figure class="vlr__fig vlr__fig--small">
        <img
          src="/images/couple-bench-garden-kumquat-trees-portrait.jpg"
          alt=""
          class="vlr__img"
          loading="lazy"
          decoding="async"
        />
      </figure>

    </div>

  </div>
</section>
