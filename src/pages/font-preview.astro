            <div class="font-sample" style="font-family: 'Times New Roman', serif; font-weight: 700; font-size: clamp(2rem, 5vw, 4rem); margin: 1rem 0; padding: 1rem; background: #f5f5f5; border-left: 4px solid #666;">
