---
import HomeBase from "../layouts/HomeBase.astro";
import FontComboPicker from "../components/sections/FontComboPicker.astro";

const showFontLab = true;
---

<HomeBase title="Font Preview">
  <div class="site">
    <main id="main">
      <section class="font-preview-section" style="padding: 4rem 2rem; background: #fff;">
        <div style="max-width: 1200px; margin: 0 auto;">
          <h1 style="font-size: 2rem; margin-bottom: 3rem; text-align: center;">Font Preview: "Veterans serving veterans."</h1>

          <!-- Barlow Condensed -->
          <div class="font-family-group" style="margin-bottom: 4rem;">
            <h2 style="font-size: 1.5rem; margin-bottom: 1rem; color: #333;">Barlow Condensed</h2>

            <div class="font-sample" style="font-family: 'Barlow Condensed', sans-serif; font-weight: 100; font-size: clamp(2rem, 5vw, 4rem); margin: 1rem 0; padding: 1rem; background: #f5f5f5; border-left: 4px solid #0e5a5c;">
              Veterans serving veterans. <span style="font-size: 1rem; font-weight: normal; color: #666;">(Weight 100 - Thin)</span>
            </div>

            <div class="font-sample" style="font-family: 'Barlow Condensed', sans-serif; font-weight: 200; font-size: clamp(2rem, 5vw, 4rem); margin: 1rem 0; padding: 1rem; background: #f5f5f5; border-left: 4px solid #0e5a5c;">
              Veterans serving veterans. <span style="font-size: 1rem; font-weight: normal; color: #666;">(Weight 200 - ExtraLight)</span>
            </div>

            <div class="font-sample" style="font-family: 'Barlow Condensed', sans-serif; font-weight: 300; font-size: clamp(2rem, 5vw, 4rem); margin: 1rem 0; padding: 1rem; background: #f5f5f5; border-left: 4px solid #0e5a5c;">
              Veterans serving veterans. <span style="font-size: 1rem; font-weight: normal; color: #666;">(Weight 300 - Light)</span>
            </div>

            <div class="font-sample" style="font-family: 'Barlow Condensed', sans-serif; font-weight: 400; font-size: clamp(2rem, 5vw, 4rem); margin: 1rem 0; padding: 1rem; background: #f5f5f5; border-left: 4px solid #0e5a5c;">
              Veterans serving veterans. <span style="font-size: 1rem; font-weight: normal; color: #666;">(Weight 400 - Regular)</span>
            </div>

            <div class="font-sample" style="font-family: 'Barlow Condensed', sans-serif; font-weight: 500; font-size: clamp(2rem, 5vw, 4rem); margin: 1rem 0; padding: 1rem; background: #f5f5f5; border-left: 4px solid #0e5a5c;">
              Veterans serving veterans. <span style="font-size: 1rem; font-weight: normal; color: #666;">(Weight 500 - Medium)</span>
            </div>

            <div class="font-sample" style="font-family: 'Barlow Condensed', sans-serif; font-weight: 600; font-size: clamp(2rem, 5vw, 4rem); margin: 1rem 0; padding: 1rem; background: #f5f5f5; border-left: 4px solid #0e5a5c;">
              Veterans serving veterans. <span style="font-size: 1rem; font-weight: normal; color: #666;">(Weight 600 - SemiBold)</span>
            </div>

            <div class="font-sample" style="font-family: 'Barlow Condensed', sans-serif; font-weight: 700; font-size: clamp(2rem, 5vw, 4rem); margin: 1rem 0; padding: 1rem; background: #f5f5f5; border-left: 4px solid #0e5a5c;">
              Veterans serving veterans. <span style="font-size: 1rem; font-weight: normal; color: #666;">(Weight 700 - Bold)</span>
            </div>

            <div class="font-sample" style="font-family: 'Barlow Condensed', sans-serif; font-weight: 800; font-size: clamp(2rem, 5vw, 4rem); margin: 1rem 0; padding: 1rem; background: #f5f5f5; border-left: 4px solid #0e5a5c;">
              Veterans serving veterans. <span style="font-size: 1rem; font-weight: normal; color: #666;">(Weight 800 - ExtraBold)</span>
            </div>

            <div class="font-sample" style="font-family: 'Barlow Condensed', sans-serif; font-weight: 900; font-size: clamp(2rem, 5vw, 4rem); margin: 1rem 0; padding: 1rem; background: #f5f5f5; border-left: 4px solid #0e5a5c;">
              Veterans serving veterans. <span style="font-size: 1rem; font-weight: normal; color: #666;">(Weight 900 - Black)</span>
            </div>

            <!-- Italics -->
            <div class="font-sample" style="font-family: 'Barlow Condensed', sans-serif; font-weight: 400; font-style: italic; font-size: clamp(2rem, 5vw, 4rem); margin: 1rem 0; padding: 1rem; background: #f5f5f5; border-left: 4px solid #c94f0f;">
              Veterans serving veterans. <span style="font-size: 1rem; font-weight: normal; color: #666;">(Weight 400 - Italic)</span>
            </div>

            <div class="font-sample" style="font-family: 'Barlow Condensed', sans-serif; font-weight: 700; font-style: italic; font-size: clamp(2rem, 5vw, 4rem); margin: 1rem 0; padding: 1rem; background: #f5f5f5; border-left: 4px solid #c94f0f;">
              Veterans serving veterans. <span style="font-size: 1rem; font-weight: normal; color: #666;">(Weight 700 - Bold Italic)</span>
            </div>
          </div>

          <!-- Inter Variable -->
          <div class="font-family-group" style="margin-bottom: 4rem;">
            <h2 style="font-size: 1.5rem; margin-bottom: 1rem; color: #333;">Inter Variable</h2>

            <div class="font-sample" style="font-family: 'Inter Variable', sans-serif; font-weight: 100; font-size: clamp(2rem, 5vw, 4rem); margin: 1rem 0; padding: 1rem; background: #f5f5f5; border-left: 4px solid #0e5a5c;">
              Veterans serving veterans. <span style="font-size: 1rem; font-weight: normal; color: #666;">(Weight 100 - Thin)</span>
            </div>

            <div class="font-sample" style="font-family: 'Inter Variable', sans-serif; font-weight: 200; font-size: clamp(2rem, 5vw, 4rem); margin: 1rem 0; padding: 1rem; background: #f5f5f5; border-left: 4px solid #0e5a5c;">
              Veterans serving veterans. <span style="font-size: 1rem; font-weight: normal; color: #666;">(Weight 200 - ExtraLight)</span>
            </div>

            <div class="font-sample" style="font-family: 'Inter Variable', sans-serif; font-weight: 300; font-size: clamp(2rem, 5vw, 4rem); margin: 1rem 0; padding: 1rem; background: #f5f5f5; border-left: 4px solid #0e5a5c;">
              Veterans serving veterans. <span style="font-size: 1rem; font-weight: normal; color: #666;">(Weight 300 - Light)</span>
            </div>

            <div class="font-sample" style="font-family: 'Inter Variable', sans-serif; font-weight: 400; font-size: clamp(2rem, 5vw, 4rem); margin: 1rem 0; padding: 1rem; background: #f5f5f5; border-left: 4px solid #0e5a5c;">
              Veterans serving veterans. <span style="font-size: 1rem; font-weight: normal; color: #666;">(Weight 400 - Regular)</span>
            </div>

            <div class="font-sample" style="font-family: 'Inter Variable', sans-serif; font-weight: 500; font-size: clamp(2rem, 5vw, 4rem); margin: 1rem 0; padding: 1rem; background: #f5f5f5; border-left: 4px solid #0e5a5c;">
              Veterans serving veterans. <span style="font-size: 1rem; font-weight: normal; color: #666;">(Weight 500 - Medium)</span>
            </div>

            <div class="font-sample" style="font-family: 'Inter Variable', sans-serif; font-weight: 600; font-size: clamp(2rem, 5vw, 4rem); margin: 1rem 0; padding: 1rem; background: #f5f5f5; border-left: 4px solid #0e5a5c;">
              Veterans serving veterans. <span style="font-size: 1rem; font-weight: normal; color: #666;">(Weight 600 - SemiBold)</span>
            </div>

            <div class="font-sample" style="font-family: 'Inter Variable', sans-serif; font-weight: 700; font-size: clamp(2rem, 5vw, 4rem); margin: 1rem 0; padding: 1rem; background: #f5f5f5; border-left: 4px solid #0e5a5c;">
              Veterans serving veterans. <span style="font-size: 1rem; font-weight: normal; color: #666;">(Weight 700 - Bold)</span>
            </div>

            <div class="font-sample" style="font-family: 'Inter Variable', sans-serif; font-weight: 800; font-size: clamp(2rem, 5vw, 4rem); margin: 1rem 0; padding: 1rem; background: #f5f5f5; border-left: 4px solid #0e5a5c;">
              Veterans serving veterans. <span style="font-size: 1rem; font-weight: normal; color: #666;">(Weight 800 - ExtraBold)</span>
            </div>

            <div class="font-sample" style="font-family: 'Inter Variable', sans-serif; font-weight: 900; font-size: clamp(2rem, 5vw, 4rem); margin: 1rem 0; padding: 1rem; background: #f5f5f5; border-left: 4px solid #0e5a5c;">
              Veterans serving veterans. <span style="font-size: 1rem; font-weight: normal; color: #666;">(Weight 900 - Black)</span>
            </div>

            <!-- Inter Italic -->
            <div class="font-sample" style="font-family: 'Inter Variable', sans-serif; font-weight: 400; font-style: italic; font-size: clamp(2rem, 5vw, 4rem); margin: 1rem 0; padding: 1rem; background: #f5f5f5; border-left: 4px solid #c94f0f;">
              Veterans serving veterans. <span style="font-size: 1rem; font-weight: normal; color: #666;">(Weight 400 - Italic)</span>
            </div>

            <div class="font-sample" style="font-family: 'Inter Variable', sans-serif; font-weight: 700; font-style: italic; font-size: clamp(2rem, 5vw, 4rem); margin: 1rem 0; padding: 1rem; background: #f5f5f5; border-left: 4px solid #c94f0f;">
              Veterans serving veterans. <span style="font-size: 1rem; font-weight: normal; color: #666;">(Weight 700 - Bold Italic)</span>
            </div>
          </div>

          <!-- Source Serif 4 Variable -->
          <div class="font-family-group" style="margin-bottom: 4rem;">
            <h2 style="font-size: 1.5rem; margin-bottom: 1rem; color: #333;">Source Serif 4 Variable</h2>

            <div class="font-sample" style="font-family: 'Source Serif 4 Variable', serif; font-weight: 200; font-size: clamp(2rem, 5vw, 4rem); margin: 1rem 0; padding: 1rem; background: #f5f5f5; border-left: 4px solid #0e5a5c;">
              Veterans serving veterans. <span style="font-size: 1rem; font-weight: normal; color: #666;">(Weight 200 - ExtraLight)</span>
            </div>

            <div class="font-sample" style="font-family: 'Source Serif 4 Variable', serif; font-weight: 300; font-size: clamp(2rem, 5vw, 4rem); margin: 1rem 0; padding: 1rem; background: #f5f5f5; border-left: 4px solid #0e5a5c;">
              Veterans serving veterans. <span style="font-size: 1rem; font-weight: normal; color: #666;">(Weight 300 - Light)</span>
            </div>

            <div class="font-sample" style="font-family: 'Source Serif 4 Variable', serif; font-weight: 400; font-size: clamp(2rem, 5vw, 4rem); margin: 1rem 0; padding: 1rem; background: #f5f5f5; border-left: 4px solid #0e5a5c;">
              Veterans serving veterans. <span style="font-size: 1rem; font-weight: normal; color: #666;">(Weight 400 - Regular)</span>
            </div>

            <div class="font-sample" style="font-family: 'Source Serif 4 Variable', serif; font-weight: 500; font-size: clamp(2rem, 5vw, 4rem); margin: 1rem 0; padding: 1rem; background: #f5f5f5; border-left: 4px solid #0e5a5c;">
              Veterans serving veterans. <span style="font-size: 1rem; font-weight: normal; color: #666;">(Weight 500 - Medium)</span>
            </div>

            <div class="font-sample" style="font-family: 'Source Serif 4 Variable', serif; font-weight: 600; font-size: clamp(2rem, 5vw, 4rem); margin: 1rem 0; padding: 1rem; background: #f5f5f5; border-left: 4px solid #0e5a5c;">
              Veterans serving veterans. <span style="font-size: 1rem; font-weight: normal; color: #666;">(Weight 600 - SemiBold)</span>
            </div>

            <div class="font-sample" style="font-family: 'Source Serif 4 Variable', serif; font-weight: 700; font-size: clamp(2rem, 5vw, 4rem); margin: 1rem 0; padding: 1rem; background: #f5f5f5; border-left: 4px solid #0e5a5c;">
              Veterans serving veterans. <span style="font-size: 1rem; font-weight: normal; color: #666;">(Weight 700 - Bold)</span>
            </div>

            <div class="font-sample" style="font-family: 'Source Serif 4 Variable', serif; font-weight: 800; font-size: clamp(2rem, 5vw, 4rem); margin: 1rem 0; padding: 1rem; background: #f5f5f5; border-left: 4px solid #0e5a5c;">
              Veterans serving veterans. <span style="font-size: 1rem; font-weight: normal; color: #666;">(Weight 800 - ExtraBold)</span>
            </div>

            <div class="font-sample" style="font-family: 'Source Serif 4 Variable', serif; font-weight: 900; font-size: clamp(2rem, 5vw, 4rem); margin: 1rem 0; padding: 1rem; background: #f5f5f5; border-left: 4px solid #0e5a5c;">
              Veterans serving veterans. <span style="font-size: 1rem; font-weight: normal; color: #666;">(Weight 900 - Black)</span>
            </div>

            <!-- Source Serif 4 Italic -->
            <div class="font-sample" style="font-family: 'Source Serif 4 Variable', serif; font-weight: 400; font-style: italic; font-size: clamp(2rem, 5vw, 4rem); margin: 1rem 0; padding: 1rem; background: #f5f5f5; border-left: 4px solid #c94f0f;">
              Veterans serving veterans. <span style="font-size: 1rem; font-weight: normal; color: #666;">(Weight 400 - Italic)</span>
            </div>

            <div class="font-sample" style="font-family: 'Source Serif 4 Variable', serif; font-weight: 700; font-style: italic; font-size: clamp(2rem, 5vw, 4rem); margin: 1rem 0; padding: 1rem; background: #f5f5f5; border-left: 4px solid #c94f0f;">
              Veterans serving veterans. <span style="font-size: 1rem; font-weight: normal; color: #666;">(Weight 700 - Bold Italic)</span>
            </div>
          </div>

          <!-- System fonts for comparison -->
          <div class="font-family-group" style="margin-bottom: 4rem;">
            <h2 style="font-size: 1.5rem; margin-bottom: 1rem; color: #333;">System Fonts (for comparison)</h2>

            <div class="font-sample" style="font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; font-weight: 700; font-size: clamp(2rem, 5vw, 4rem); margin: 1rem 0; padding: 1rem; background: #f5f5f5; border-left: 4px solid #666;">
              Veterans serving veterans. <span style="font-size: 1rem; font-weight: normal; color: #666;">(System UI - Bold)</span>
            </div>

            <div class="font-sample" style="font-family: Georgia, 'Times New Roman', serif; font-weight: 700; font-size: clamp(2rem, 5vw, 4rem); margin: 1rem 0; padding: 1rem; background: #f5f5f5; border-left: 4px solid #666;">
