---
/**
 * Homepage: the site as one continuous recovery story.
 *
 * Each component below has a single editorial job:
 * conflict, proof, origin, audience stakes, care path, donor action.
 */

import HomeBase from "../layouts/HomeBase.astro";
import ContactSection from "../components/sections/ContactSection.astro";
import FontComboPicker from "../components/sections/FontComboPicker.astro";
import HeroSection from "../components/sections/HeroSection.astro";
import MissionStatement from "../components/sections/MissionStatement.astro";
import SiteHeader from "../components/sections/SiteHeader.astro";
import SiteFooter from "../components/sections/SiteFooter.astro";
import VeteranAccessHero from "../components/sections/VeteranAccessHero.astro";
import VeteranCareProblem from "../components/sections/VeteranCareProblem.astro";
import VeteranCareGap from "../components/sections/VeteranCareGap.astro";
import VeteranLifeReturn from "../components/sections/VeteranLifeReturn.astro";
import VeteranVoices from "../components/sections/VeteranVoices.astro";
import Why22Strong from "../components/sections/Why22Strong.astro";
import LeadershipVideo from "../components/sections/LeadershipVideo.astro";
import ForVeterans from "../components/sections/ForVeterans.astro";
import DonorCTA from "../components/sections/DonorCTA.astro";
import StrongCircleBlock from "../components/sections/StrongCircleBlock.astro";
import FinalCTA from "../components/sections/FinalCTA.astro";
import home from "../content/home.json";
import { buildAudienceGroups } from "../utils/home-story";

const audienceGroups = buildAudienceGroups(home);
const showFontLab = import.meta.env.DEV && Astro.url.searchParams.has("fontlab");
---

<HomeBase title="">
  <div class="site">
    <SiteHeader current="home" />

    <main id="main">
      <HeroSection
        heading={home.hero.heading}
        lead={home.hero.lead}
      />

      <VeteranAccessHero />
      <VeteranCareProblem />
      <VeteranCareGap />
      <VeteranLifeReturn />
      <VeteranVoices />
      <Why22Strong />
      <LeadershipVideo />
      <ForVeterans />
      <DonorCTA />
      <StrongCircleBlock />
      <FinalCTA />

      <MissionStatement
        heading={home.mission.heading}
        lead={home.mission.lead}
        impact={home.mission.impact}
        eyebrow="Mission Statement"
      />

      <ContactSection contact={home.contact} />
    </main>

    <SiteFooter footer={home.footer} />
    {showFontLab && <FontComboPicker />}
  </div>
</HomeBase>
